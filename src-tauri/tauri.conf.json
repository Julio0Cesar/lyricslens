{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lyricslens",
  "version": "0.4.1",
  "identifier": "com.kintiz.lyricslens",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "LyricsLens Overlay",
        "width": 760,
        "height": 260,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": true,
        "visible": false,
        "maximizable": false
      },
      {
        "label": "settings",
        "title": "LyricsLens — Configurações",
        "width": 560,
        "height": 720,
        "minWidth": 420,
        "minHeight": 480,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Music",
    "shortDescription": "Overlay de letras sincronizadas",
    "longDescription": "Detecta a música tocando no sistema, busca a letra sincronizada e a mostra numa janela flutuante sobre qualquer aplicativo.",
    "homepage": "https://github.com/Julio0Cesar/lyricslens",
    "publisher": "Julio0Cesar",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libgtk-layer-shell0"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3",
          "gtk-layer-shell"
        ]
      }
    }
  }
}
